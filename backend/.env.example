APP_NAME="Retention Analytics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Docker Compose defaults (see ../docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=retention
DB_USERNAME=retention
DB_PASSWORD=secret

SESSION_DRIVER=file
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Analytics ---------------------------------------------------------------
RFM_PERIOD_DAYS=365
ACTIVE_WINDOW_DAYS=540
CHURN_HORIZON_DAYS=90
# Size of the synthetic customer base generated by the seeder.
DEMO_CUSTOMERS=1500

# --- AI (fake model only; see App\Ai\Fakes\FakeLlmClient) --------------------
AI_MODEL=fake-analyst-1
AI_MONTHLY_BUDGET_USD=20
# Demo: the fake model answers with broken JSON first to show the repair loop.
AI_FAKE_MALFORMED_FIRST=true
RETENTION_QUEUE=ai
